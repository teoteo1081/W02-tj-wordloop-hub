{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOEIC ingest profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "year",
    "edition",
    "source_status",
    "structure_verified",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2099
    },
    "edition": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "source_status": {
      "enum": [
        "not_found",
        "available"
      ]
    },
    "source_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "structure_verified": {
      "type": "boolean"
    },
    "parts": {
      "const": {
        "1": [
          1,
          6
        ],
        "2": [
          7,
          31
        ],
        "3": [
          32,
          70
        ],
        "4": [
          71,
          100
        ],
        "5": [
          101,
          130
        ],
        "6": [
          131,
          146
        ],
        "7": [
          147,
          200
        ]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "sources"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "sources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lc_pdf": {
                "$ref": "#/$defs/source"
              },
              "rc_pdf": {
                "$ref": "#/$defs/source"
              },
              "audio": {
                "$ref": "#/$defs/source"
              },
              "answer_key": {
                "$ref": "#/$defs/source"
              },
              "reference_key": {
                "$ref": "#/$defs/source"
              },
              "structured": {
                "$ref": "#/$defs/source"
              },
              "cues": {
                "$ref": "#/$defs/source"
              },
              "enrichment": {
                "$ref": "#/$defs/source"
              },
              "transcript": {
                "$ref": "#/$defs/source"
              },
              "lc_book": {
                "$ref": "#/$defs/source"
              },
              "rc_book": {
                "$ref": "#/$defs/source"
              },
              "whisper": {
                "$ref": "#/$defs/source"
              }
            }
          },
          "graphics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "page",
                "box"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "lc_pdf",
                    "rc_pdf"
                  ]
                },
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "box": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "num": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                },
                "group": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 98
                }
              },
              "oneOf": [
                {
                  "required": [
                    "num"
                  ],
                  "not": {
                    "required": [
                      "group"
                    ]
                  }
                },
                {
                  "required": [
                    "group"
                  ],
                  "not": {
                    "required": [
                      "num"
                    ]
                  }
                }
              ]
            }
          },
          "review": {
            "type": "object"
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ffmpeg": {
          "type": "string",
          "minLength": 1
        },
        "ffprobe": {
          "type": "string",
          "minLength": 1
        },
        "tesseract": {
          "type": "string",
          "minLength": 1
        },
        "whisper_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "credential_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "quota_checked": {
          "type": "boolean"
        },
        "quota_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "budget_approved": {
          "type": "boolean"
        },
        "timeout": {
          "type": "number",
          "minimum": 1,
          "maximum": 180
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_ref": {
          "type": "string",
          "minLength": 1
        },
        "supabase_url": {
          "type": "string",
          "minLength": 1
        },
        "image_base": {
          "type": "string",
          "minLength": 1
        },
        "audio_base": {
          "type": "string",
          "minLength": 1
        },
        "r2_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "r2_bucket": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2099
        },
        "test_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_status": {
            "const": "not_found"
          }
        }
      },
      "then": {
        "properties": {
          "tests": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
