{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOEIC source inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "year",
    "edition",
    "profile_hash",
    "status",
    "issues",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2099
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED_SOURCE"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_number",
          "sources",
          "issues"
        ],
        "properties": {
          "test_number": {
            "type": "integer",
            "minimum": 1
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/file"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/issue"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "text_pages": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
